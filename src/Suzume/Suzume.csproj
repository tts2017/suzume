<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Suzume.Core\Suzume.Core.csproj" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\sounds\*.wav" LogicalName="Suzume.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dalamud はプラグインの DLL の隣にある images/icon.png をアイコンとして表示する -->
    <None Include="..\..\assets\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
